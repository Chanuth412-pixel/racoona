---
import BaseLayout from '../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---
<BaseLayout title="Current Openings | Racoona AI">
  <main class="min-h-screen bg-slate-50 pt-24 pb-16">
    <div class="max-w-5xl mx-auto px-6">
      <h1 class="text-4xl font-light text-slate-900 tracking-tight mb-4">Current Openings</h1>
      <p class="text-slate-600 mb-12">Join our engineering and infrastructure teams.</p>
      
      <div class="space-y-4">
        <!-- Placeholder Job Card -->
        <div class="bg-white p-6 border border-slate-200 flex justify-between items-center group hover:border-blue-500 transition-colors">
          <div>
            <h2 class="text-lg font-bold text-slate-900">Senior Cloud DevOps Engineer</h2>
            <p class="text-sm text-slate-500">Remote / Hybrid • Full-Time</p>
          </div>
          <a href={`${base}/contact`} class="text-blue-600 font-semibold group-hover:translate-x-1 transition-transform">Apply &rarr;</a>
        </div>
      </div>
    </div>
  </main>
</BaseLayout>
