---
import BaseLayout from '../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase : `${rawBase}/`;

const operationalFramework = [
	{
		step: '01',
		title: 'Invest',
		description: 'Growth capital for expansion and strategic opportunities.'
	},
	{
		step: '02',
		title: 'Modernize',
		description: 'Upgrade POS, data, inventory, ordering, and operational infrastructure.'
	},
	{
		step: '03',
		title: 'Grow',
		description: 'Customer acquisition, loyalty, direct ordering, and retention.'
	},
	{
		step: '04',
		title: 'Expand',
		description: 'Leverage improved economics and infrastructure to support additional locations.'
	}
];

const partnerCriteria = [
	{ title: 'Proven restaurant concept', desc: 'Established brand identity with strong customer demand and market resonance.' },
	{ title: 'Strong unit economics', desc: 'Solid baseline profit margins with clear opportunities for operational enhancement.' },
	{ title: 'Loyal customer base', desc: 'High repeat business, active community engagement, and organic brand advocacy.' },
	{ title: 'Expansion potential', desc: 'Scalable operational footprint suitable for regional or multi-unit rollout.' },
	{ title: 'Experienced operators', desc: 'Dedicated leadership and kitchen management focused on quality and consistency.' },
	{ title: 'Clear path to additional locations', desc: 'Identified target markets and real estate strategies for disciplined growth.' }
];
---

<BaseLayout title="Hospitality Growth Capital & Modernization - Racoona AI" description="Racoona combines growth capital, technology, and operational expertise to help high-potential restaurants increase revenue, improve margins, and expand.">
	<!-- HERO SECTION (Pure White / Light Mode Base) -->
	<div class="relative overflow-hidden bg-slate-50 pt-26 pb-20 border-b border-slate-200">
	  
	  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
	    
	    <!-- Left Column: Typography & Action -->
	    <div class="text-left relative z-10">
	      
	      <p class="animate-title-1 text-amber-700 font-sans text-xs tracking-widest uppercase mb-4 font-semibold">
	        Hospitality Investment & Operations
	      </p>

	      <h1 class="animate-title-2 text-5xl md:text-6xl font-bold tracking-tight text-slate-900 mb-6 font-sans leading-tight">
	        We Invest in Great <br />
	        <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-600 via-yellow-600 to-amber-700">
	          Hospitality Businesses.
	        </span>
	      </h1>

	      <p class="animate-title-3 text-slate-600 text-lg font-sans leading-relaxed mb-10 max-w-lg">
	        Racoona combines growth capital, technology, and operational expertise to help high-potential restaurants increase revenue, improve margins, and expand.
	      </p>

	      <div class="animate-title-3 flex flex-col sm:flex-row gap-4">
	        <a href={`${base}contact?interest=hospitality`} class="inline-flex justify-center items-center px-6 py-3.5 rounded-xl bg-amber-600 text-white font-sans font-bold hover:bg-amber-700 transition-colors shadow-md">
	          Explore Partnership
	        </a>
	        <a href="#case-study" class="inline-flex justify-center items-center px-6 py-3.5 rounded-xl border border-slate-300 bg-white text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-colors font-medium font-sans shadow-sm">
	          View Case Study
	        </a>
	      </div>
	    </div>

	    <!-- Right Column: Visual Asset Window Container -->
	    <div class="relative z-10 hidden lg:block">
	      <div class="absolute inset-0 bg-amber-400/20 blur-[90px] rounded-full pointer-events-none transform -translate-y-1/4"></div>

	      <div class="relative bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xl transform hover:-translate-y-2 transition-transform duration-500">
	        <!-- Window Controls Header -->
	        <div class="h-8 border-b border-slate-200 bg-slate-100 flex items-center px-4 gap-2">
	          <div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div>
	          <div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div>
	          <div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div>
	        </div>
	        
	        <img 
	          src={`${base}dwaraka-hero.jpg`} 
	          alt="Dwaraka's Bawarchi Ashburn" 
	          class="w-full h-auto object-cover opacity-95 hover:opacity-100 transition-opacity"
	        />
	      </div>
	    </div>

	  </div>
	</div>

	<!-- Featured Case Study Container (Dwaraka's Bawarchi) -->
	<section id="case-study" class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-b border-slate-200">
		<div class="mb-12">
			<span class="font-sans text-xs uppercase tracking-widest text-amber-700 font-semibold">Active Partnership</span>
			<h2 class="mt-2 text-3xl sm:text-4xl font-bold font-sans text-slate-900">Featured Partnership Case Study</h2>
		</div>

		<div class="bg-white border border-slate-200 rounded-2xl overflow-hidden shadow-lg">
			<div class="grid grid-cols-1 lg:grid-cols-2">
				
				<!-- Left Column: Image Asset -->
				<div class="relative h-72 lg:h-auto bg-slate-100 min-h-[380px]">
					<img 
						src={`${base}dwaraka-buffet.jpg`} 
						alt="Dwaraka's Bawarchi Operations" 
						class="absolute inset-0 w-full h-full object-cover"
					/>
					<div class="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-transparent lg:bg-gradient-to-r lg:from-transparent lg:to-slate-900/10"></div>
				</div>

				<!-- Right Column: Case Study Copy & Details + Metrics Grid -->
				<div class="p-8 sm:p-12 lg:p-14 flex flex-col justify-center relative z-10 bg-white">
					<div class="text-amber-700 font-sans text-xs tracking-widest uppercase mb-3 font-semibold">FEATURED COLLABORATION</div>
					<h3 class="text-3xl font-bold font-sans text-slate-900 mb-4">Dwaraka's Bawarchi</h3>
					<p class="text-slate-600 mb-8 leading-relaxed font-sans text-base">
						We are actively partnering with Dwaraka's Bawarchi, a premier dining destination in Ashburn, VA. By combining growth capital, modern ordering infrastructure, and data-driven marketing, we helped accelerate revenue and operational efficiency.
					</p>
					
					<!-- 3-Column Hard Metrics Grid -->
					<div class="grid grid-cols-3 gap-4 p-5 rounded-xl bg-amber-50/60 border border-amber-200/80 mb-8">
						<div class="text-center sm:text-left">
							<div class="text-2xl sm:text-3xl font-extrabold font-sans text-amber-700">+38%</div>
							<div class="text-xs font-sans font-medium text-slate-600 mt-1">Direct orders</div>
						</div>
						<div class="text-center sm:text-left border-l border-amber-200/80 pl-3 sm:pl-4">
							<div class="text-2xl sm:text-3xl font-extrabold font-sans text-amber-700">+24%</div>
							<div class="text-xs font-sans font-medium text-slate-600 mt-1">Repeat customers</div>
						</div>
						<div class="text-center sm:text-left border-l border-amber-200/80 pl-3 sm:pl-4">
							<div class="text-2xl sm:text-3xl font-extrabold font-sans text-amber-700">-17%</div>
							<div class="text-xs font-sans font-medium text-slate-600 mt-1">Customer acquisition cost</div>
						</div>
					</div>

					<div class="space-y-3 mb-8 font-sans text-sm">
						<div class="flex items-start">
							<span class="text-amber-600 mr-3 font-bold">✓</span>
							<span class="text-slate-700">Direct ordering & revenue channel optimization</span>
						</div>
						<div class="flex items-start">
							<span class="text-amber-600 mr-3 font-bold">✓</span>
							<span class="text-slate-700">POS & ordering infrastructure modernization</span>
						</div>
						<div class="flex items-start">
							<span class="text-amber-600 mr-3 font-bold">✓</span>
							<span class="text-slate-700">Targeted local marketing and customer retention</span>
						</div>
					</div>

					<a 
						href="https://www.dwarakasbawarchiashburn.com" 
						target="_blank" 
						rel="noopener noreferrer"
						class="inline-flex items-center justify-center bg-amber-600 hover:bg-amber-700 text-white px-6 py-3.5 rounded-xl font-sans font-bold transition-all duration-300 w-max shadow-md"
					>
						<span>Visit Partner Website</span>
						<svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
						</svg>
					</a>
				</div>

			</div>
		</div>
	</section>

	<!-- Partner Visual Gallery Showcase -->
	<section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-b border-slate-200">
		<div class="mb-12">
			<span class="font-sans text-xs uppercase tracking-widest text-slate-500 font-semibold">Operations Showcase</span>
			<h2 class="mt-2 text-2xl sm:text-3xl font-bold font-sans text-slate-900">Hospitality & Culinary Operations</h2>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			<div class="relative group rounded-2xl overflow-hidden border border-slate-200 bg-white h-80 shadow-md">
				<img 
					src={`${base}dwaraka-food.jpg`} 
					alt="Dwaraka's Culinary Excellence" 
					class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-95 group-hover:opacity-100"
				/>
				<div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/30 to-transparent p-6 flex flex-col justify-end">
					<span class="text-xs font-sans text-amber-300 uppercase tracking-widest font-semibold">Culinary Excellence</span>
					<h3 class="text-xl font-bold text-white font-sans mt-1">High-Quality Menu Standards</h3>
				</div>
			</div>

			<div class="relative group rounded-2xl overflow-hidden border border-slate-200 bg-white h-80 shadow-md">
				<img 
					src={`${base}dwaraka-biriyani.jpg`} 
					alt="Dwaraka's Biriyani Dining Experience" 
					class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-95 group-hover:opacity-100"
				/>
				<div class="absolute inset-0 bg-gradient-to-t from-slate-900/80 via-slate-900/30 to-transparent p-6 flex flex-col justify-end">
					<span class="text-xs font-sans text-amber-300 uppercase tracking-widest font-semibold">Operational Scaling</span>
					<h3 class="text-xl font-bold text-white font-sans mt-1">Dining Experience & Multi-Unit Scale</h3>
				</div>
			</div>
		</div>
	</section>

	<!-- The Model (Restructured 4-Pillar Grid) -->
	<section id="model" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-b border-slate-200">
		<div class="mb-12 text-center sm:text-left">
			<span class="font-sans text-xs uppercase tracking-widest text-amber-700 font-semibold">Value Creation Framework</span>
			<h2 class="mt-2 text-3xl font-bold font-sans text-slate-900">The Model</h2>
			<p class="mt-3 text-slate-600 text-base font-sans max-w-2xl">
				Our four-stage partnership model drives sustainable revenue growth, operational efficiency, and unit expansion.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
			{operationalFramework.map(pillar => (
				<div class="p-7 rounded-2xl border border-slate-200 bg-white flex flex-col justify-between hover:border-amber-500 hover:shadow-lg transition-all duration-300 group">
					<div>
						<div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center font-sans text-sm font-extrabold text-amber-700 mb-6 group-hover:bg-amber-600 group-hover:text-white transition-colors">
							{pillar.step}
						</div>
						<h3 class="text-xl font-bold font-sans text-slate-900 mb-3 group-hover:text-amber-700 transition-colors">{pillar.title}</h3>
						<p class="text-slate-600 text-sm leading-relaxed font-sans">{pillar.description}</p>
					</div>
				</div>
			))}
		</div>
	</section>

	<!-- Who We Partner With Section -->
	<section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-b border-slate-200 bg-slate-50/50">
		<div class="max-w-3xl mb-14">
			<span class="font-sans text-xs uppercase tracking-widest text-amber-700 font-semibold">Partnership Criteria</span>
			<h2 class="mt-2 text-3xl sm:text-4xl font-bold font-sans text-slate-900">Who We Partner With</h2>
			<p class="mt-4 text-slate-700 text-lg font-sans font-medium">
				Independent restaurants • Multi-unit operators • Emerging restaurant groups
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
			{partnerCriteria.map((item) => (
				<div class="p-6 rounded-xl border border-slate-200 bg-white shadow-sm hover:border-amber-400 hover:shadow-md transition-all duration-300 flex items-start space-x-4">
					<div class="w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-amber-700 font-bold text-base flex-shrink-0 mt-0.5">
						✓
					</div>
					<div>
						<h3 class="text-base font-bold font-sans text-slate-900 mb-1">{item.title}</h3>
						<p class="text-slate-600 text-xs font-sans leading-relaxed">{item.desc}</p>
					</div>
				</div>
			))}
		</div>
	</section>

	<!-- Final Evaluation CTA Section -->
	<section class="py-24 text-center max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-white">
		<div class="max-w-2xl mx-auto">
			<span class="font-sans text-xs uppercase tracking-widest text-amber-700 font-semibold">Get Started</span>
			<h2 class="text-3xl font-bold font-sans text-slate-900 mt-2 mb-4">Explore a Partnership</h2>
			<p class="text-slate-600 text-base font-sans mb-8 leading-relaxed">
				Tell us about your concept, current operations, and growth plans. Our team will evaluate the opportunity and determine whether Racoona can help accelerate your next stage.
			</p>
			<a href={`${base}contact?interest=hospitality`} class="inline-flex items-center justify-center px-8 py-4 rounded-xl bg-amber-600 text-white font-bold text-base hover:bg-amber-700 transition-all duration-300 font-sans shadow-md hover:shadow-lg">
				Explore Partnership
			</a>
		</div>
	</section>
</BaseLayout>
