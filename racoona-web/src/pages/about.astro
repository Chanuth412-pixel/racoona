---
import BaseLayout from '../layouts/BaseLayout.astro';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<BaseLayout title="About Us - Racoona AI" description="Learn about Racoona AI, our multi-sector operations, mission, and global headquarters in Ashburn, VA.">
	<div class="relative overflow-hidden py-20 bg-slate-50">

		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
			
			<!-- Hero Header -->
			<div class="text-center max-w-3xl mx-auto mb-20">
				<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full border border-slate-300 bg-white mb-6 shadow-sm">
					<span class="text-xs font-mono font-semibold text-slate-700 uppercase tracking-widest">About Racoona AI</span>
				</div>
				<h1 class="text-4xl sm:text-5xl font-extrabold tracking-tight text-slate-900 font-sans">
					Architecting Next-Generation Enterprise Systems & Investments
				</h1>
				<p class="mt-6 text-base sm:text-lg text-slate-600 font-sans leading-relaxed">
					Racoona AI unites modern software engineering, high-availability IT services, and predictive data operations for food & hospitality assets.
				</p>
			</div>

			<!-- Core Pillars Grid -->
			<div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-20">
				
				<div class="p-8 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 transition-all duration-300 shadow-sm">
					<div class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-800 mb-6">
						<svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>
						</svg>
					</div>
					<h2 class="text-xl font-bold text-slate-900 mb-3 font-sans">Software Engineering</h2>
					<p class="text-sm text-slate-600 leading-relaxed font-sans">
						Building enterprise software, custom AI models, microservice architectures, and robust web systems tailored to demanding technical environments.
					</p>
				</div>

				<div class="p-8 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 transition-all duration-300 shadow-sm">
					<div class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-800 mb-6">
						<svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M12 5l7 7-7 7"/>
						</svg>
					</div>
					<h2 class="text-xl font-bold text-slate-900 mb-3 font-sans">IT Operations</h2>
					<p class="text-sm text-slate-600 leading-relaxed font-sans">
						Delivering 24/7 managed infrastructure, cloud architecture, cybersecurity defense, and operational reliability for growing enterprises.
					</p>
				</div>

				<div class="p-8 rounded-2xl border border-slate-200 bg-white hover:border-slate-300 transition-all duration-300 shadow-sm">
					<div class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-800 mb-6">
						<svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1"/>
						</svg>
					</div>
					<h2 class="text-xl font-bold text-slate-900 mb-3 font-sans">Food & Hospitality</h2>
					<p class="text-sm text-slate-600 leading-relaxed font-sans">
						Deploying strategic capital, POS integration, and predictive demand analytics to scale culinary and hospitality ventures efficiently.
					</p>
				</div>

			</div>

			<!-- Headquarters & Location Section -->
			<div class="p-8 sm:p-12 rounded-3xl border border-slate-200 bg-white relative overflow-hidden shadow-sm">
				<div class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center">
					<div class="space-y-6">
						<h2 class="text-2xl sm:text-3xl font-bold text-slate-900 font-sans">Global Headquarters</h2>
						<p class="text-sm sm:text-base text-slate-600 leading-relaxed font-sans">
							Racoona AI operates from Ashburn, Virginia—a premier tech corridor. Our teams collaborate across technological and investment frontiers to build dependable systems.
						</p>

						<div class="border-t border-slate-200 pt-6 space-y-4 font-sans">
							<div class="flex items-start gap-4">
								<div class="p-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-800">
									<svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
									</svg>
								</div>
								<div>
									<h3 class="text-xs font-mono uppercase text-slate-500 tracking-wider">Corporate Address</h3>
									<p class="text-base font-semibold text-slate-900 mt-1">
										Belvoir Woods Terrace<br />
										Ashburn, VA 20148
									</p>
								</div>
							</div>

							<div class="flex items-start gap-4 pt-2">
								<div class="p-3 rounded-xl bg-slate-100 border border-slate-200 text-slate-800">
									<svg width="24" height="24" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
									</svg>
								</div>
								<div>
									<h3 class="text-xs font-mono uppercase text-slate-500 tracking-wider">Email Inquiry</h3>
									<p class="text-base font-semibold text-slate-900 mt-1">info@racoona.com</p>
								</div>
							</div>
						</div>
					</div>

					<div class="p-6 rounded-2xl border border-slate-200 bg-slate-50 flex flex-col justify-between h-full space-y-6">
						<h3 class="text-lg font-bold text-slate-900 font-sans">Connect With Racoona AI</h3>
						<p class="text-sm text-slate-600 font-sans leading-relaxed">
							Interested in partnering, requesting tech services, or discussing investment opportunities? Get in touch with our leadership team.
						</p>
						<a 
							href={`${base}/contact`} 
							class="inline-block text-center px-6 py-3.5 rounded-xl bg-slate-900 hover:bg-black text-white font-sans font-bold text-sm transition-all duration-300 shadow-sm"
						>
							Contact Corporate Office
						</a>
					</div>
				</div>
			</div>

		</div>
	</div>
</BaseLayout>
