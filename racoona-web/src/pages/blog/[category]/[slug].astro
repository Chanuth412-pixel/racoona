---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const techPosts = await getCollection('technology');
  const foodPosts = await getCollection('food');
  const servicePosts = await getCollection('services');

  const allPosts = [
    ...techPosts.map(post => ({ params: { category: 'technology', slug: post.id }, props: { post, category: 'technology' } })),
    ...foodPosts.map(post => ({ params: { category: 'food', slug: post.id }, props: { post, category: 'food' } })),
    ...servicePosts.map(post => ({ params: { category: 'services', slug: post.id }, props: { post, category: 'services' } })),
  ];

  return allPosts;
}

const { post, category } = Astro.props;
const { Content } = await render(post);

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;
---

<BaseLayout title={`${post.data.title} - Racoona AI Blog`} description={post.data.description}>
  <div class="bg-slate-50 py-20 min-h-screen">
    <article class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 bg-white p-8 sm:p-12 rounded-3xl border border-slate-200 shadow-sm">
      
      <!-- Category & Back Link Header -->
      <div class="mb-8">
        <a href={`${base}/blog`} class="inline-flex items-center text-xs font-mono text-slate-700 hover:text-slate-900 font-semibold hover:underline mb-6">
          &larr; Back to Blog Overview
        </a>
        <div class="flex items-center gap-3">
          <span class="px-3 py-1 rounded-full text-xs font-mono font-bold uppercase tracking-wider bg-slate-100 text-slate-800 border border-slate-200">
            {category}
          </span>
          <span class="text-xs font-mono text-slate-500">
            {new Date(post.data.pubDate).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </span>
        </div>
        <h1 class="text-3xl sm:text-5xl font-extrabold font-sans text-slate-900 mt-4 leading-tight">
          {post.data.title}
        </h1>
        <p class="mt-4 text-lg text-slate-600 font-sans leading-relaxed">
          {post.data.description}
        </p>
        <div class="mt-6 flex items-center gap-2 text-xs font-mono text-slate-500 border-b border-slate-200 pb-8">
          <span>By <strong class="text-slate-900 font-semibold">{post.data.author}</strong></span>
        </div>
      </div>

      <!-- Article Content Body -->
      <div class="prose prose-slate max-w-none font-sans text-slate-700 leading-relaxed space-y-6">
        <Content />
      </div>

      <!-- Tags -->
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="mt-12 pt-6 border-t border-slate-200 flex flex-wrap gap-2">
          {post.data.tags.map((tag: string) => (
            <span class="px-2.5 py-1 rounded bg-slate-100 border border-slate-200 text-xs font-mono text-slate-700 font-medium">
              #{tag}
            </span>
          ))}
        </div>
      )}

    </article>
  </div>
</BaseLayout>
