---
import BaseLayout from '../layouts/BaseLayout.astro';
import TechStackMarquee from '../components/TechStackMarquee.astro';
import InferenceCube from '../components/InferenceCube.tsx';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const cloudPlatforms = [
	{
		name: 'Amazon Web Services',
		abbr: 'AWS',
		color: 'from-amber-500/20 to-orange-500/10',
		borderColor: 'border-amber-500/30',
		textColor: 'text-amber-400',
		desc: 'ECS/EKS, Lambda, S3, SageMaker LLM hosting & IAM security policies.',
		svg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />`
	},
	{
		name: 'Microsoft Azure',
		abbr: 'Azure',
		color: 'from-blue-500/20 to-cyan-500/10',
		borderColor: 'border-blue-500/30',
		textColor: 'text-blue-400',
		desc: 'Azure OpenAI Service, AKS Kubernetes, Cognitive Services & Hybrid Cloud.',
		svg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 15a4 4 0 004 4h9a5 5 0 001.09-9.88A5.5 5.5 0 008.5 6 5.5 5.5 0 003 11.5A4 4 0 003 15z" />`
	},
	{
		name: 'Google Cloud Platform',
		abbr: 'GCP',
		color: 'from-emerald-500/20 to-teal-500/10',
		borderColor: 'border-emerald-500/30',
		textColor: 'text-emerald-400',
		desc: 'Vertex AI, GKE Clusters, BigQuery Data Pipelines & Cloud Run microservices.',
		svg: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />`
	}
];
---

<BaseLayout title="Software Engineering & AI Proof of Concepts - Racoona AI" description="Production-grade AI integration, Cloud Computing, Proof of Concepts (POCs), and Forward Deployed Engineering.">
	<!-- ASYMMETRIC HERO SECTION -->
	<div class="relative overflow-hidden bg-slate-50 pt-28 pb-30 border-b border-slate-200">
	  
	  <div class="max-w-7xl mx-auto px-6 grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
	    
	    <!-- Left Column: Typography & Action -->
	    <div class="text-left relative z-10">
	      
	      <p class="animate-title-1 text-blue-600 font-sans text-xs tracking-widest uppercase mb-4 font-semibold">
	        Division 01 — Software Engineering & AI Proof of Concepts
	      </p>

	      <h1 class="animate-title-2 text-5xl md:text-6xl font-bold tracking-tight text-slate-900 mb-6 font-sans leading-tight">
	        AI, Cloud & Fast <br />
	        <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-600 to-indigo-700">
	          Proof of Concepts.
	        </span>
	      </h1>

	      <p class="animate-title-3 text-slate-600 text-lg font-sans leading-relaxed mb-10 max-w-lg">
	        Deploying production AI models, multi-cloud computing infrastructure, and rapid Proof of Concept (POC) pilots.
	      </p>

	      <div class="animate-title-3 flex flex-col sm:flex-row gap-4">
	        <a href={`${base}/contact?interest=software`} class="inline-flex justify-center items-center px-6 py-3 rounded-xl bg-blue-600 text-white font-sans font-bold hover:bg-blue-700 transition-colors shadow-md">
	          Initiate AI / POC Project
	        </a>
	        <a href="#forward-deployed" class="inline-flex justify-center items-center px-6 py-3 rounded-xl border border-slate-300 bg-white text-slate-700 hover:text-slate-900 hover:bg-slate-100 transition-colors font-medium font-sans shadow-sm">
	          Forward Deployed Engineers
	        </a>
	      </div>
	    </div>

	    <!-- Right Column: Visual Asset -->
	    <div class="relative z-10 hidden lg:block">
	      <div class="absolute inset-0 bg-blue-500/10 blur-[80px] rounded-full pointer-events-none transform -translate-y-1/4"></div>
	      
	      <div class="relative bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xl transform hover:-translate-y-2 transition-transform duration-500">
	        <div class="h-8 border-b border-slate-200 bg-slate-100 flex items-center px-4 gap-2">
	          <div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div>
	          <div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div>
	          <div class="w-2.5 h-2.5 rounded-full bg-slate-300"></div>
	        </div>
	        
	        <img 
	          src={`${base}/software-hero-light.png`} 
	          alt="Software Architecture Visualization" 
	          class="w-full h-auto object-cover opacity-95 hover:opacity-100 transition-opacity"
	        />
	      </div>
	    </div>

	  </div>
	</div>

	<!-- Continuous Infinite Tech Stack Marquee -->
	<TechStackMarquee />

	<!-- Multi-Cloud Infrastructure & Pilot Logo Grid (AWS, Azure, GCP) -->
	<section class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 border-b border-slate-200">
		<div class="text-center max-w-2xl mx-auto mb-12">
			<span class="font-sans text-xs uppercase tracking-widest text-blue-600 font-semibold">Multi-Cloud Ecosystem</span>
			<h2 class="mt-2 text-2xl sm:text-3xl font-bold font-sans text-slate-900">Supported Cloud Infrastructure & Pilot Environments</h2>
			<p class="mt-3 text-sm text-slate-600 font-sans">
				We architect, test, and deploy AI POCs across top tier global cloud ecosystems with 100% compatibility.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-3 gap-8">
			<!-- AWS Card -->
			<div class="bg-white border border-slate-200 rounded-2xl relative group hover:border-blue-500/50 transition-all shadow-md overflow-hidden">
				<div class="w-full h-48 bg-slate-100 flex items-center justify-center border-b border-slate-200 rounded-t-2xl relative overflow-hidden">
					<!-- Official AWS SVG Logo (Enlarged) -->
					<svg viewBox="0 0 512 512" class="w-28 h-28">
						<path fill="#FF9900" d="M256 0C114.6 0 0 114.6 0 256s114.6 256 256 256 256-114.6 256-256S397.4 0 256 0zM176.5 352.2c-2.4 1.3-6.2.8-11.4-1.5-22.3-10.9-46.3-25.2-72-42.9-2.2-1.5-2.7-3.6-1.5-6.3 7.8-17.7 15.6-35.4 23.4-53.1 1.1-2.6 3.1-3.6 6-3 15.8 3.2 31.7 6.4 47.5 9.6 1.8.4 3.1 1.5 3.9 3.3 3.9 10.4 7.8 20.8 11.7 31.2 1.6 4.3 1.6 8.5 0 12.8-2.5 6.7-5 13.4-7.6 20.1zM345.5 338c-3.1 1.8-6.9 1.6-11.4-.7-23.7-12.1-48.4-28-74.2-47.7-2.1-1.6-2.6-3.7-1.4-6.3 8.3-18.4 16.7-36.8 25-55.2 1.1-2.5 3-3.5 5.7-3 16.1 3.2 32.2 6.5 48.3 9.7 1.8.4 3.1 1.5 3.8 3.3 4.2 11.1 8.5 22.2 12.7 33.3 1.5 4 1.5 8 0 12-1.9 5.8-3.9 11.6-5.9 17.4.4.6.8 1.1 1.2 1.7z"/>
					</svg>
				</div>
				<div class="p-6 flex flex-col gap-3">
					<h3 class="text-xl font-bold font-sans text-slate-900">Amazon Web Services</h3>
					<p class="text-slate-600 text-sm font-sans leading-relaxed">ECS/EKS, Lambda, S3, SageMaker LLM hosting & IAM security policies.</p>
				</div>
			</div>

			<!-- Azure Card -->
			<div class="bg-white border border-slate-200 rounded-2xl relative group hover:border-blue-500/50 transition-all shadow-md overflow-hidden">
				<div class="w-full h-48 bg-slate-100 flex items-center justify-center border-b border-slate-200 rounded-t-2xl relative overflow-hidden">
					<!-- Official Azure SVG Logo (Enlarged) -->
					<svg viewBox="0 0 110.5 96" class="w-28 h-28">
						<path fill="#0089D6" d="M43.2 12.5L16.4 59.8h26.8l8.9-15.6L43.2 12.5z"/>
						<path fill="#0078D4" d="M0 77.5h69.2l13.9-24.2-26.8-46.7L0 77.5z"/>
						<path fill="#24292E" d="M74.8 25.1l11.6 20.2-11.6 20.3H51.6l26.8 46.7h32.1L74.8 25.1z"/>
					</svg>
				</div>
				<div class="p-6 flex flex-col gap-3">
					<h3 class="text-xl font-bold font-sans text-slate-900">Microsoft Azure</h3>
					<p class="text-slate-600 text-sm font-sans leading-relaxed">Azure OpenAI Service, AKS Kubernetes, Cognitive Services & Hybrid Cloud.</p>
				</div>
			</div>

			<!-- GCP Card -->
			<div class="bg-white border border-slate-200 rounded-2xl relative group hover:border-teal-500/50 transition-all shadow-md overflow-hidden">
				<div class="w-full h-48 bg-slate-100 flex items-center justify-center border-b border-slate-200 rounded-t-2xl relative overflow-hidden">
					<!-- Official GCP SVG Logo (Enlarged) -->
					<svg viewBox="0 0 24 24" class="w-28 h-28">
						<path fill="#4285F4" d="M12 11.25v2.5h5.5c-.3 1.7-1.8 3-3.5 3-2.1 0-3.8-1.7-3.8-3.8s1.7-3.8 3.8-3.8c1 0 1.9.4 2.5 1l1.8-1.8c-1.2-1.1-2.8-1.8-4.3-1.8-3.9 0-7 3.1-7 7s3.1 7 7 7c4 0 6.7-2.8 6.7-6.8 0-.5 0-.9-.1-1.3H12z"/>
					</svg>
				</div>
				<div class="p-6 flex flex-col gap-3">
					<h3 class="text-xl font-bold font-sans text-slate-900">Google Cloud Platform</h3>
					<p class="text-slate-600 text-sm font-sans leading-relaxed">Vertex AI, GKE Clusters, BigQuery Data Pipelines & Cloud Run microservices.</p>
				</div>
			</div>
		</div>
	</section>

	<!-- Interactive AI Inference Pipeline -->
	<section id="pipeline" class="py-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
		<div class="mb-8">
			<span class="font-sans text-xs uppercase tracking-widest text-blue-600 font-semibold">Interactive POC Demo</span>
			<h2 class="mt-2 text-2xl sm:text-3xl font-bold font-sans text-slate-900">Live AI Inference Pipeline</h2>
			<p class="mt-2 text-sm text-slate-600 font-sans max-w-xl">
				Simulating high-throughput sequence orchestration across edge gateways, vLLM inference nodes, and real-time streaming output endpoints.
			</p>
		</div>

		<div class="w-full flex justify-center bg-slate-50 border border-slate-200 rounded-2xl p-4 overflow-hidden shadow-sm">
			<InferenceCube client:visible />
		</div>
	</section>

	<!-- Forward Deployed Engineer (FDE) Capability Section -->
	<section id="forward-deployed" class="py-24 border-t border-slate-200 bg-slate-50">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
			<div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
				<!-- Left Column: High-Density Bento Stats Grid -->
				<div>
					<h2 class="text-3xl sm:text-4xl font-bold font-sans text-slate-900 leading-tight">
						Forward Deployed Engineers (FDE)
					</h2>
					<p class="mt-4 text-base text-slate-600 font-sans leading-relaxed">
						We embed senior elite software engineers directly alongside your internal engineering and executive teams to build, validate, and launch AI & cloud Proof of Concepts (POCs) in real time.
					</p>

					<!-- 2x2 Bento Stats Grid -->
					<div class="grid grid-cols-2 gap-4 mt-8">
						<div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
							<span class="text-xs font-mono text-slate-500 block mb-1">Time to MVP</span>
							<span class="text-blue-700 font-bold text-lg block">48 Hours</span>
						</div>
						<div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
							<span class="text-xs font-mono text-slate-500 block mb-1">System Uptime</span>
							<span class="text-blue-700 font-bold text-lg block">99.99%</span>
						</div>
						<div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
							<span class="text-xs font-mono text-slate-500 block mb-1">Legacy Migration</span>
							<span class="text-slate-900 font-semibold block text-sm sm:text-base">Zero Downtime</span>
						</div>
						<div class="bg-white border border-slate-200 rounded-xl p-4 shadow-sm">
							<span class="text-xs font-mono text-slate-500 block mb-1">Integration</span>
							<span class="text-slate-900 font-semibold block text-sm sm:text-base">Direct On-Site</span>
						</div>
					</div>

					<div class="mt-8">
						<a href={`${base}/contact?interest=software`} class="inline-flex items-center px-6 py-3 rounded-xl bg-blue-600 text-white font-sans font-bold hover:bg-blue-700 transition-colors shadow-md">
							Request an FDE Deployment
						</a>
					</div>
				</div>

				<!-- Right Column: Active CI/CD Pipeline Dashboard -->
				<div class="p-6 sm:p-8 rounded-2xl border border-slate-200 bg-white shadow-md relative overflow-hidden">
					<!-- Dashboard Header Window Controls -->
					<div class="flex items-center justify-between border-b border-slate-200 pb-4 mb-6">
						<div class="flex items-center gap-2">
							<div class="w-3 h-3 rounded-full bg-slate-200"></div>
							<div class="w-3 h-3 rounded-full bg-slate-300"></div>
							<div class="w-3 h-3 rounded-full bg-slate-400"></div>
						</div>
						<span class="text-xs font-mono text-slate-500 font-semibold">FDE_EXECUTION_PIPELINE.sh</span>
					</div>

					<!-- Vertical Connected Pipeline Stepper -->
					<div class="relative space-y-6">
						<!-- Vertical Connecting Line -->
						<div class="w-px bg-slate-200 absolute left-3.5 top-3 bottom-3 z-0"></div>

						<!-- Phase 1 -->
						<div class="flex items-start gap-4 relative z-10">
							<div class="w-7 h-7 flex items-center justify-center shrink-0 mt-1">
								<span class="w-4 h-4 rounded-full bg-blue-600 ring-4 ring-blue-50 relative z-10"></span>
							</div>
							<div class="bg-slate-50 border border-slate-200 rounded-lg p-4 w-full hover:bg-blue-50/50 transition-colors">
								<h3 class="text-slate-900 font-bold text-sm font-sans mb-1">Phase 1: Discovery & Architecture</h3>
								<p class="text-slate-600 text-xs leading-relaxed font-sans">Blueprint definitions, model selection, and security audit.</p>
							</div>
						</div>

						<!-- Phase 2 -->
						<div class="flex items-start gap-4 relative z-10">
							<div class="w-7 h-7 flex items-center justify-center shrink-0 mt-1">
								<span class="w-3.5 h-3.5 rounded-full bg-blue-600 relative z-10"></span>
							</div>
							<div class="bg-slate-50 border border-slate-200 rounded-lg p-4 w-full hover:bg-blue-50/50 transition-colors">
								<h3 class="text-slate-900 font-bold text-sm font-sans mb-1">Phase 2: Rapid Prototyping & MVP</h3>
								<p class="text-slate-600 text-xs leading-relaxed font-sans">Embedded co-development, LLM fine-tuning, and edge API routing.</p>
								<div class="mt-3 pt-2 border-t border-slate-200/80 flex items-center gap-4 text-slate-400 text-xs font-mono">
									<span>Commits: <strong class="text-slate-600">42</strong></span>
									<span>|</span>
									<span>Test Coverage: <strong class="text-slate-600">98%</strong></span>
								</div>
							</div>
						</div>

						<!-- Phase 3 -->
						<div class="flex items-start gap-4 relative z-10">
							<div class="w-7 h-7 flex items-center justify-center shrink-0 mt-1">
								<span class="w-3.5 h-3.5 rounded-full border-2 border-blue-600 bg-white relative z-10"></span>
							</div>
							<div class="bg-slate-50 border border-slate-200 rounded-lg p-4 w-full hover:bg-blue-50/50 transition-colors">
								<h3 class="text-slate-900 font-bold text-sm font-sans mb-1">Phase 3: Production Scaling</h3>
								<p class="text-slate-600 text-xs leading-relaxed font-sans">Zero-downtime deployment, automated CI/CD pipelines, and telemetry hand-off.</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>

	<!-- Call to Action -->
	<section class="py-20 border-t border-slate-200 text-center max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 bg-slate-50">
		<div class="max-w-xl mx-auto">
			<h2 class="text-2xl font-bold text-slate-900 mb-3 font-sans">Initiate Software & AI POC</h2>
			<p class="text-slate-600 text-sm mb-8 font-sans">
				Discuss your architecture requirements, AI models, and cloud migration timelines with our forward deployed engineers.
			</p>
			<a href={`${base}/contact?interest=software`} class="inline-block px-6 py-3 rounded-xl bg-blue-600 text-white font-semibold text-sm hover:bg-blue-700 transition-colors font-sans shadow-md">
				Start a Development Project
			</a>
		</div>
	</section>
</BaseLayout>

