---
const { number, title, description, capabilities, href } = Astro.props;
---

<a href={href} class="group relative flex flex-col justify-between bg-zinc-950 border border-zinc-800/80 rounded-lg p-6 hover:border-zinc-700 transition-all duration-200 block">
  
  <div>
    <div class="flex items-center justify-between mb-4">
      <span class="font-mono text-xs text-zinc-500 tracking-wider font-semibold">{number}</span>
      <span class="h-1.5 w-1.5 rounded-full bg-zinc-700 group-hover:bg-cyan-400 transition-colors"></span>
    </div>

    <h3 class="text-lg font-semibold text-zinc-100 tracking-tight mb-2 group-hover:text-cyan-400 transition-colors">
      {title}
    </h3>

    <p class="text-zinc-400 text-sm leading-relaxed mb-6 font-normal">
      {description}
    </p>
  </div>

  <div class="pt-4 border-t border-zinc-800/80 mt-auto">
    <div class="text-[11px] font-mono text-zinc-500 uppercase tracking-wider mb-3">Capabilities</div>
    <ul class="space-y-1.5">
      {capabilities.map((item: string) => (
        <li class="flex items-center text-xs font-mono text-zinc-300">
          <span class="text-zinc-500 mr-2 font-normal">-</span>
          <span>{item}</span>
        </li>
      ))}
    </ul>
  </div>

</a>
