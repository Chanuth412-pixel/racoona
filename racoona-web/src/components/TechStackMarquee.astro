---
const techStack = [
  { 
    category: "Machine Learning", 
    title: "Python", 
    details: "PyTorch, vLLM, TensorRT",
    svg: `<svg class="w-6 h-6 text-blue-600 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C6.48 2 6 4 6 6v3h6v1H5C3 10 2 11.48 2 14v4c0 2 2 3.5 4 3.5h3v-3c0-2 1.5-3.5 3.5-3.5h3.5c1.5 0 2.5-1 2.5-2.5V9c0-2-1.5-3.5-3.5-3.5H12V4c0-1.5-.5-2-3-2z"/><circle cx="8.5" cy="5.5" r="1" fill="currentColor"/><circle cx="15.5" cy="18.5" r="1" fill="currentColor"/></svg>`
  },
  { 
    category: "Backend Systems", 
    title: "Node.js", 
    details: "Distributed Services, Async I/O",
    svg: `<svg class="w-6 h-6 text-emerald-600 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L3 7v10l9 5 9-5V7l-9-5z"/><path d="M12 12l9-5M12 12v10M12 12L3 7"/></svg>`
  },
  { 
    category: "Interface Layer", 
    title: "React", 
    details: "Single Page Applications, SSR",
    svg: `<svg class="w-6 h-6 text-blue-600 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><ellipse cx="12" cy="12" rx="9" ry="3.5" transform="rotate(30 12 12)"/><ellipse cx="12" cy="12" rx="9" ry="3.5" transform="rotate(90 12 12)"/><ellipse cx="12" cy="12" rx="9" ry="3.5" transform="rotate(150 12 12)"/><circle cx="12" cy="12" r="1.5" fill="currentColor"/></svg>`
  },
  { 
    category: "Static Architecture", 
    title: "Astro", 
    details: "Island Hydration, Performance",
    svg: `<svg class="w-6 h-6 text-purple-600 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2L4.5 20.5h15L12 2z"/><path d="M9.5 15h5"/><path d="M12 6l-2 5h4l-2-5z"/></svg>`
  },
  { 
    category: "Cloud Infrastructure", 
    title: "AWS", 
    details: "EKS, ECS, S3, IAM, CloudFront",
    svg: `<svg class="w-6 h-6 text-amber-600 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6.5 8.5L4 14.5h2.5l.8-2h2.4l.8 2H13L10.5 8.5h-4zm1.5 1.8l.7 1.7h-1.4l.7-1.7z"/><path d="M4 18c4 2.5 12 2.5 16 0M18 16.5l2 1.5-2.5 1"/></svg>`
  },
  { 
    category: "Containerization", 
    title: "Docker", 
    details: "Multi-stage Builds, Micro-images",
    svg: `<svg class="w-6 h-6 text-blue-600 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="11" width="3" height="3" rx="0.5"/><rect x="6" y="11" width="3" height="3" rx="0.5"/><rect x="10" y="11" width="3" height="3" rx="0.5"/><rect x="6" y="7" width="3" height="3" rx="0.5"/><rect x="10" y="7" width="3" height="3" rx="0.5"/><rect x="14" y="11" width="3" height="3" rx="0.5"/><path d="M1 15c1 4 5 6 11 6 8 0 11-4 11-7v-1h-4c-1 0-2-1-2-2v-1"/></svg>`
  },
  { 
    category: "Orchestration", 
    title: "Kubernetes", 
    details: "Auto-scaling, Ingress Controllers",
    svg: `<svg class="w-6 h-6 text-blue-700 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l8.5 4.9v9.8L12 21.6l-8.5-4.9V6.9L12 2z"/><path d="M12 6.5l5 2.9v5.8l-5 2.9-5-2.9V9.4l5-2.9z"/><circle cx="12" cy="12" r="2"/></svg>`
  },
  { 
    category: "Data Storage", 
    title: "PostgreSQL", 
    details: "Relational DB, pgvector, Partitioning",
    svg: `<svg class="w-6 h-6 text-indigo-600 mb-2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2C6.5 2 3 5 3 9.5c0 3.5 2 6 5 7.5L7 21l4-2h1c5.5 0 9-3 9-9.5S17.5 2 12 2z"/><circle cx="9" cy="8" r="1.5" fill="currentColor"/></svg>`
  },
];
---

<div class="w-full py-12 overflow-hidden bg-white border-y border-slate-200">
  
  <div class="max-w-7xl mx-auto px-6 mb-8">
    <span class="text-xs font-sans font-semibold text-blue-600 tracking-widest uppercase">TECHSTACK SPECIFICATION</span>
    <h2 class="text-2xl font-bold font-sans text-slate-900 tracking-tight mt-1">Technology Architecture</h2>
  </div>

  <!-- Marquee Container -->
  <div class="flex w-full relative">
    
    <!-- Gradient Masks for smooth fade in/out at the edges -->
    <div class="absolute inset-y-0 left-0 w-32 bg-gradient-to-r from-white to-transparent z-10 pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-32 bg-gradient-to-l from-white to-transparent z-10 pointer-events-none"></div>

    <!-- Scrolling Track 1 -->
    <div class="flex min-w-full shrink-0 animate-marquee items-center justify-around gap-6 px-3">
      {techStack.map((item) => (
        <div class="shrink-0 w-80 p-5 bg-white border border-slate-200 rounded-xl hover:border-slate-300 transition-colors shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-sans font-medium text-slate-500 uppercase tracking-wider">{item.category}</span>
            <Fragment set:html={item.svg} />
          </div>
          <h4 class="text-lg font-bold font-sans text-slate-900 mb-1">{item.title}</h4>
          <p class="text-xs font-sans text-blue-700 font-medium">{item.details}</p>
        </div>
      ))}
    </div>

    <!-- Scrolling Track 2 (Duplicate for seamless loop) -->
    <div class="flex min-w-full shrink-0 animate-marquee items-center justify-around gap-6 px-3" aria-hidden="true">
      {techStack.map((item) => (
        <div class="shrink-0 w-80 p-5 bg-white border border-slate-200 rounded-xl hover:border-slate-300 transition-colors shadow-sm">
          <div class="flex items-center justify-between mb-3">
            <span class="text-xs font-sans font-medium text-slate-500 uppercase tracking-wider">{item.category}</span>
            <Fragment set:html={item.svg} />
          </div>
          <h4 class="text-lg font-bold font-sans text-slate-900 mb-1">{item.title}</h4>
          <p class="text-xs font-sans text-blue-700 font-medium">{item.details}</p>
        </div>
      ))}
    </div>
    
  </div>
</div>

