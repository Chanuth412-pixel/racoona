---
// CapitalTicker.astro
const tickerItems = [
  {
    tag: "ACQUISITION_LOCKED",
    node: "MIA_04",
    metric1: "CAPITAL_DEPLOYED: $2.4M",
    metric2: "TARGET_LIFT: +42%"
  },
  {
    tag: "SYSTEM_UPGRADE",
    node: "ATX_01",
    metric1: "POS_PIPELINE_MIGRATED",
    metric2: "INGESTION: STABLE"
  },
  {
    tag: "TELEMETRY",
    node: "PORTFOLIO_AVG",
    metric1: "RETENTION_DELTA: +18.4%",
    metric2: "MoM_GROWTH: ACTIVE"
  },
  {
    tag: "EQUITY_PARTNERSHIP",
    node: "NYC_09",
    metric1: "LEASE_ACQUIRED",
    metric2: "REV_DELTA: +58.2%"
  }
];
---

<div class="w-full py-4 overflow-hidden bg-zinc-950/80 border-y border-zinc-800/80 font-sans text-xs">
  <div class="flex w-full relative">
    
    <!-- Edge Gradient Masks -->
    <div class="absolute inset-y-0 left-0 w-24 bg-gradient-to-r from-[#09090b] to-transparent z-10 pointer-events-none"></div>
    <div class="absolute inset-y-0 right-0 w-24 bg-gradient-to-l from-[#09090b] to-transparent z-10 pointer-events-none"></div>

    <!-- Scrolling Track 1 -->
    <div class="flex min-w-full shrink-0 animate-marquee items-center justify-around gap-8 px-4">
      {tickerItems.map((item) => (
        <div class="shrink-0 flex items-center gap-3 bg-zinc-900/60 border border-zinc-800/80 px-4 py-2 rounded-lg">
          <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
          <span class="text-purple-400 font-sans font-bold text-[11px]">[{item.tag}]</span>
          <span class="text-zinc-200 font-mono font-semibold">NODE: {item.node}</span>
          <span class="text-zinc-500 font-mono">//</span>
          <span class="text-zinc-300 font-mono">{item.metric1}</span>
          <span class="text-zinc-500 font-mono">//</span>
          <span class="text-emerald-400 font-mono font-bold">{item.metric2}</span>
        </div>
      ))}
    </div>

    <!-- Scrolling Track 2 (Duplicate for seamless loop) -->
    <div class="flex min-w-full shrink-0 animate-marquee items-center justify-around gap-8 px-4" aria-hidden="true">
      {tickerItems.map((item) => (
        <div class="shrink-0 flex items-center gap-3 bg-zinc-900/60 border border-zinc-800/80 px-4 py-2 rounded-lg">
          <span class="w-2 h-2 rounded-full bg-purple-400 animate-pulse"></span>
          <span class="text-purple-400 font-sans font-bold text-[11px]">[{item.tag}]</span>
          <span class="text-zinc-200 font-mono font-semibold">NODE: {item.node}</span>
          <span class="text-zinc-500 font-mono">//</span>
          <span class="text-zinc-300 font-mono">{item.metric1}</span>
          <span class="text-zinc-500 font-mono">//</span>
          <span class="text-emerald-400 font-mono font-bold">{item.metric2}</span>
        </div>
      ))}
    </div>

  </div>
</div>
